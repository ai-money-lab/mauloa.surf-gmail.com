# ═══════════════════════════════════════════════════
# HIROKI AI Empire — 環境変数テンプレート
# コピーしてプロジェクトルートに .env として配置:
#   cp config/.env.example .env
# ═══════════════════════════════════════════════════

# ═══ Claude API（必須）═══
ANTHROPIC_API_KEY=

# ═══ X Developer API（System A: 投稿に必要）═══
X_API_KEY=
X_API_SECRET_KEY=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ═══ TwitterAPI.io（System A Pipeline1: バズ収集に必要）═══
TWITTERAPI_IO_KEY=

# ═══ Google Sheets（実績記録に使用・任意）═══
GOOGLE_SHEETS_CREDENTIALS_PATH=./config/credentials.json
SHEETS_POST_MANAGEMENT_ID=
SHEETS_ORDER_MANAGEMENT_ID=

# ═══ Google Drive（納品に使用・任意）═══
GOOGLE_DRIVE_DELIVERABLES_FOLDER_ID=

# ═══ e-Stat API（System C: 統計データ収集・任意）═══
ESTAT_API_KEY=

# ═══ LINE Messaging API（問い合わせBot・LINE連携時に必要）═══
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ═══ 通知（LINE Notify / Slack・任意）═══
LINE_NOTIFY_TOKEN=
SLACK_WEBHOOK_URL=

# ═══ 問い合わせBot（Google Sheets連携・任意）═══
INQUIRY_BOT_SHEET_ID=

# ═══ 問い合わせBot URL（ヘルスチェック用・デフォルト: http://localhost:8080）═══
INQUIRY_BOT_URL=
